DirectoryIndex index.php
Options -Indexes
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set X-Frame-Options "DENY"
</IfModule>

# Deny direct HTTP access to local state/temporary files (PHP filesystem access is unaffected).
<FilesMatch "(?i)\.(?:json|lock|tmp|bak|log|sql|ini|env)$">
Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^private_data(?:/|$) - [F,L]
</IfModule>
